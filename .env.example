# Copy to .env (git-ignored). Local defaults below are examples, never production secrets.
# APP_ENV: dev | test | prod. UNSET MEANS prod (fail closed): prod forbids fake/hash
# providers, the default API_KEY_PEPPER/USER_REF_KEY, and always hides the API docs.
APP_ENV=dev
# Compose host ports (loopback only); shell exports override these values.
API_PORT=8000
DB_PORT=5434
REDIS_PORT=6380
LOG_LEVEL=INFO
# Host tools use published ports; Compose overrides these with db/redis service names.
DATABASE_URL=postgresql+asyncpg://emporio:emporio@localhost:5434/emporio
REDIS_URL=redis://localhost:6380/0
# Generate a private random value; changing this invalidates existing API-key hashes.
API_KEY_PEPPER=dev-only-pepper-change-me
# Separate HMAC key for opaque user references (WhatsApp wa_id, client IPs in rate-limit
# keys, query-embedding cache keys). Generate a private random value outside dev.
USER_REF_KEY=dev-only-user-ref-key-change-me
# /docs, /redoc and /openapi.json; forced off when APP_ENV=prod.
EXPOSE_API_DOCS=true

# Deterministic defaults avoid paid external calls during local setup.
LLM_PROVIDER=fake
EMBEDDING_PROVIDER=hash
# Set a credential only when selecting openai; never commit the populated .env.
# OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-5-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# Fixed by database schema; changing dimensions requires migration and re-embedding.
EMBEDDING_DIMENSIONS=1536
MODEL_TIMEOUT_SECONDS=30
MAX_AGENT_TURNS=8
# Keep disabled: exported traces must never contain customer content.
OPENAI_TRACING_ENABLED=false

CHUNK_SIZE_TOKENS=650
CHUNK_OVERLAP_TOKENS=80
MAX_UPLOAD_BYTES=10485760
MAX_TEXT_CHARS=500000
RETRIEVAL_TOP_K=6
RETRIEVAL_CANDIDATE_K=20
RETRIEVAL_MIN_SIMILARITY=0.30
RRF_K=60
QUERY_EMBEDDING_CACHE_TTL_SECONDS=3600
# queue for Compose worker; inline processes uploads in the API process.
INGESTION_MODE=queue
TOOL_TIMEOUT_SECONDS=5
# Per-statement Postgres timeout for the app's connections (the retention purge raises it).
DB_STATEMENT_TIMEOUT_MS=5000

# Abuse protection (Redis-backed AttemptLimiter). If Redis is down, request limits allow
# traffic (logged); the order-lookup lockout fails closed.
# Failed order verifications per order and per end user before lockout, and lockout window.
ORDER_LOOKUP_MAX_FAILURES=3
ORDER_LOOKUP_LOCKOUT_SECONDS=3600
# Chat turns per minute per API key (/v1/chat/messages -> 429) and per WhatsApp user.
CHAT_RATE_LIMIT_PER_MINUTE=30
# Failed authentications per minute per client IP before 429 (one audit row per IP/minute).
AUTH_FAILURE_LIMIT_PER_MINUTE=20
# Conversations (messages, tool executions, handoffs) and audit events older than this are
# purged daily by the worker, or manually: uv run python -m scripts.purge_retention
RETENTION_DAYS=90

# Optional WhatsApp integration secrets (leave unset when disabled).
# WHATSAPP_VERIFY_TOKEN=
# WHATSAPP_APP_SECRET=
# WHATSAPP_ACCESS_TOKEN=
WHATSAPP_GRAPH_API_BASE=https://graph.facebook.com/v21.0

# Seed-only variables (not Settings fields).
# ./scripts/docker_up.sh generates this inside Docker if absent, without printing it.
# Manual container-only setup is documented in README.md.
# Add the generated key to .env to run: docker compose --profile seed run --rm seed
# Format: emp_<8 lowercase alphanumeric prefix>_<32-128 URL-safe secret characters>
# SEED_API_KEY is an ADMIN key (all scopes): for operators only, never in a web widget.
# SEED_API_KEY=
# Optional chat-only key (scope "chat") for a public web widget; same format, different value.
# SEED_CHAT_API_KEY=
# Optional external WhatsApp phone-number ID; creates a tenant channel mapping.
# WHATSAPP_PHONE_NUMBER_ID=

# Test-only admin connection; tests create and drop their own random databases.
# TEST_DATABASE_ADMIN_URL=postgresql+asyncpg://emporio:emporio@localhost:5434/postgres
