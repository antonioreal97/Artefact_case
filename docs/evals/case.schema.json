{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Emporio agent evaluation case",
  "type": "object",
  "required": ["id", "category", "risk", "messages", "expected_tools", "assertions", "source_refs", "critical"],
  "properties": {
    "id": {"type": "string", "pattern": "^[a-z0-9_-]+$"},
    "category": {"type": "string"},
    "risk": {"enum": ["low", "medium", "high"]},
    "messages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["role", "content"],
        "properties": {
          "role": {"enum": ["user", "assistant"]},
          "content": {"type": "string"}
        },
        "additionalProperties": false
      }
    },
    "expected_tools": {"type": "array", "items": {"type": "string"}},
    "forbidden_tools": {"type": "array", "items": {"type": "string"}, "default": []},
    "tool_inputs": {"type": "object", "default": {}},
    "assertions": {
      "type": "object",
      "properties": {
        "contains_any": {"type": "array", "items": {"type": "string"}},
        "contains_all": {"type": "array", "items": {"type": "string"}},
        "excludes_all": {"type": "array", "items": {"type": "string"}},
        "must_ask_clarification": {"type": "boolean"},
        "must_refuse": {"type": "boolean"},
        "must_require_verification": {"type": "boolean"},
        "max_words": {"type": "integer", "minimum": 1}
      },
      "additionalProperties": false
    },
    "source_refs": {"type": "array", "items": {"type": "string"}},
    "expected_route": {
      "enum": ["deterministic_local", "local_model", "external_allowed", "human_handoff"]
    },
    "external_egress_allowed": {"type": "boolean"},
    "critical": {"type": "boolean"},
    "notes": {"type": "string"}
  },
  "additionalProperties": false
}

